---
/**
 * Página 404.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/url';
import { SUBJECTS } from '../config/site';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe en la biblioteca de apuntes de ASIR."
  noIndex
>
  <div class="wrap wrap--narrow">
    <div class="empty" style="padding:4rem 1.5rem">
      <Icon name="search-x" size={40} />
      <p class="empty__title">Esta página no existe</p>
      <p class="empty__text">
        Puede que el enlace esté mal escrito o que el apunte se haya reorganizado. Prueba a buscarlo
        o vuelve al inicio.
      </p>
      <div class="hero__actions" style="justify-content:center">
        <button type="button" class="btn btn--primary" data-search-open>
          <Icon name="search" size={16} /> Buscar
        </button>
        <a class="btn" href={withBase('')}><Icon name="house" size={16} /> Inicio</a>
      </div>
    </div>

    <section class="section" aria-labelledby="suggest-title">
      <div class="section__head">
        <h2 class="section__title" id="suggest-title">
          <Icon name="library" size={18} /> Ir a una asignatura
        </h2>
      </div>
      <div class="quick">
        {
          SUBJECTS.map((subject) => (
            <a class="quick__item" href={withBase(`asignaturas/${subject.slug}/`)}>
              <Icon name={subject.icon} size={18} />
              <span class="quick__text">
                <span class="quick__title">{subject.name}</span>
                <span class="quick__sub">{subject.fullName}</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
